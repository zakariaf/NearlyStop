  "actionNextStep": "Next step",
  "actionCancel": "Cancel",
  "@actionCancel": {
    "description": "The cancel action on a confirmation sheet. Cancelling a destructive action is deliberately the easy path."
  },
  "actionClose": "Close",
  "@actionClose": {
    "description": "The action on the disclaimer sheet when it is opened to be re-read from Settings, rather than as the first-run gate."
  },
  "actionUndo": "Undo",
  "@actionUndo": {
    "description": "The action on the app’s one undo surface. Never a SnackBar: it times out before this reader finishes it."
  },
  "stateUnavailable": "Unavailable",
  "@stateUnavailable": {
    "description": "Appended to a disabled control’s SEMANTICS label. A disabled button that only dims is invisible to a screen reader and to anyone with low contrast vision, so the state is said in words as well."
  },
  "@actionNextStep": {
    "description": "Begin the next reduction. Enabled only when the current step is complete.",
    "x-maxChars": 26
  },
  "stepOfTotal": "Step {current} of {total}",
  "@stepOfTotal": {
    "description": "Which reduction the patient is on, out of the plan's total.",
    "placeholders": {
      "current": {
        "type": "int",
        "example": "3"
      },
      "total": {
        "type": "int",
        "example": "15"
      }
    },
    "x-maxChars": 22
  },
  "dayOfStep": "Day {day} of {length}",
  "@dayOfStep": {
    "description": "Position within the current 52-day step. Deliberately not a week number — the pattern ignores that a week has seven days.",
    "placeholders": {
      "day": {
        "type": "int",
        "example": "14"
      },
      "length": {
        "type": "int",
        "example": "52"
      }
    },
    "x-maxChars": 22
  },
  "blockOfTotal": "Block {current} of {total}",
  "blockCompleted": "Completed",
  "@blockCompleted": {
    "description": "The word on a finished block header. Said as a WORD, not only as a green tint: a reader who cannot see the tint still has to know the block is behind them."
  },
  "@blockOfTotal": {
    "description": "Which of the eleven blocks of the pattern this is.",
    "placeholders": {
      "current": {
        "type": "int",
        "example": "3"
      },
      "total": {
        "type": "int",
        "example": "11"
      }
    },
    "x-maxChars": 24
  },
  "blockPattern": "one day at {newDose}, then {oldDays, plural, =1{1 day} other{{oldDays} days}} at {oldDose}",
  "@blockPattern": {
    "description": "The teaching sentence under a block header: the new dose is taken on one day, the old dose on the days between. Word order differs per language, so the counts are ICU branches rather than spliced numbers.",
    "placeholders": {
      "newDose": {
        "type": "String",
        "example": "9mg"
      },
      "oldDays": {
        "type": "int",
        "example": "4"
      },
      "oldDose": {
        "type": "String",
        "example": "10mg"
      }
    }
  },
  "doseTransition": "{from} to {to}",
  "@doseTransition": {
    "description": "The step's reduction, read aloud and shown in the context line.",
    "placeholders": {
      "from": {
        "type": "String",
        "example": "10mg"
      },
      "to": {
        "type": "String",
        "example": "9mg"
      }
    }
  },
  "tabletBreakdown": "{parts}",
  "@tabletBreakdown": {
    "description": "The tablets that make up a dose, e.g. '1 x 5mg . 4 x 1mg'. The value is a Latin-script run inside a possibly right-to-left sentence and arrives already bidi-isolated; this message must not add punctuation around it.",
    "placeholders": {
      "parts": {
        "type": "String",
        "example": "1 × 5mg · 4 × 1mg"
      }
    }
  },
  "yesterdayNotTicked": "Yesterday wasn't ticked — mark it now?",
  "@yesterdayNotTicked": {
    "description": "Offered on Today when the previous day has no record. A question, never a reprimand."
  },
  "takenDays": "{count, plural, =1{1 day taken} other{{count} days taken}}",
  "@takenDays": {
    "description": "How many days have been recorded as taken.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "341"
      }
    }
  },
