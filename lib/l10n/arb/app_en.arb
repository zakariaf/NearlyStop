  "actionAddNote": "Add note",
  "@actionAddNote": {
    "description": "Opens the note field for the day.",
    "x-maxChars": 16
  },
  "actionHold": "Hold",
  "@actionHold": {
    "description": "Stay on the current block for a few more days.",
