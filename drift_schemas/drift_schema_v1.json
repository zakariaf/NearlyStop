  "fixed_sql": [
    {
      "name": "taper_plans",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"taper_plans\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"uid\" TEXT NOT NULL UNIQUE, \"drug_name\" TEXT NOT NULL DEFAULT 'Prednisolone', \"start_date\" TEXT NOT NULL, \"starting_dose\" INTEGER NOT NULL, \"target_dose\" INTEGER NOT NULL, \"tablet_strengths\" TEXT NOT NULL, \"allow_halves\" INTEGER NOT NULL CHECK (\"allow_halves\" IN (0, 1)), \"method\" TEXT NOT NULL, \"percentage\" REAL NULL, \"fixed_step\" INTEGER NULL, \"hold_period_days\" INTEGER NOT NULL DEFAULT 52, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "steps",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"steps\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"uid\" TEXT NOT NULL UNIQUE, \"plan_id\" INTEGER NOT NULL, \"step_index\" INTEGER NOT NULL, \"from_dose\" INTEGER NOT NULL, \"to_dose\" INTEGER NOT NULL, \"start_date\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"pattern_version\" INTEGER NOT NULL, UNIQUE(plan_id, step_index), FOREIGN KEY(plan_id) REFERENCES taper_plans(id) ON DELETE CASCADE);"
        }
      ]
    },
    {
