      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"dose_logs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"uid\" TEXT NOT NULL UNIQUE, \"plan_id\" INTEGER NOT NULL, \"date\" TEXT NOT NULL, \"planned_mg\" INTEGER NOT NULL, \"actual_mg\" INTEGER NOT NULL, \"taken\" INTEGER NOT NULL CHECK (\"taken\" IN (0, 1)), \"taken_at\" INTEGER NULL, \"note\" TEXT NULL, UNIQUE(plan_id, date), FOREIGN KEY(plan_id) REFERENCES taper_plans(id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "flare_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"flare_events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"uid\" TEXT NOT NULL UNIQUE, \"plan_id\" INTEGER NOT NULL, \"date\" TEXT NOT NULL, \"revert_to_dose\" INTEGER NOT NULL, \"note\" TEXT NULL, FOREIGN KEY(plan_id) REFERENCES taper_plans(id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "hold_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"hold_events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"uid\" TEXT NOT NULL UNIQUE, \"step_id\" INTEGER NOT NULL, \"from_date\" TEXT NOT NULL, \"extra_days\" INTEGER NOT NULL, \"note\" TEXT NULL, CHECK(extra_days > 0), FOREIGN KEY(step_id) REFERENCES steps(id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "settings_rows",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings_rows\" (\"id\" INTEGER NOT NULL, \"uid\" TEXT NOT NULL UNIQUE, \"reminder_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"reminder_enabled\" IN (0, 1)), \"reminder_minute_of_day\" INTEGER NULL, \"text_scale\" REAL NOT NULL DEFAULT 1.0, \"high_contrast\" INTEGER NOT NULL DEFAULT 0 CHECK (\"high_contrast\" IN (0, 1)), \"disclaimer_accepted_at\" INTEGER NULL, \"locale_tag\" TEXT NULL, \"theme_mode\" TEXT NOT NULL DEFAULT 'system', PRIMARY KEY (\"id\"), CHECK(id = 0));"
        }
      ]
    }
