# Written by tool/coverage_include_untested.sh before a coverage run so that
# untested lib/ files land in the denominator. Regenerated every time; never
# committed.
test/zzz_coverage_all_files_test.dart

# NOTE: pubspec.lock is deliberately NOT ignored. This is an application, and the
# committed lock is what makes a stranger's clone resolve the versions that were
# tested (dependency-hygiene rule 2). Never ignore design/reference/*.png either.

# Golden diff artefacts. Written on a red run, never committed.
**/failures/

# ---------------------------------------------------------------- EPIC-15
# Signing material NEVER lives in this repo. CI injects it from secrets at
# build time. `tool/check_release_hygiene.sh` checks the working tree AND the
# whole of `git log --all` — a credential committed and later deleted is
# invisible to a working-tree check and permanently present in every clone.
key.properties
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision
service-account*.json
AuthKey_*.p8
